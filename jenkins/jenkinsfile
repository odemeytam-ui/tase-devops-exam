@Library('my-shared-library') _

pipeline {
    agent any

    options {
        timestamps()
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('Prepare Environment') {
            steps {
                script {
                    def scmInfo = prepareEnv()

                    echo "Commit ID: ${scmInfo.commitId}"
                    echo "Committer: ${scmInfo.committer}"
                    echo "Commit message: ${scmInfo.commitMessage}"
                }
            }
        }

        stage('Build') {
            steps {
                echo 'Building application...'

                sh '''
                    set -eu

                    test -f app/app.py
                    test -f app/requirements.txt
                    test -f app/dockerfile
                    test -f tests/test_app.py

                    python3 -m compileall -q app tests

                    docker version
                    docker compose version

                    export POSTGRES_DB=tase_ci
                    export POSTGRES_USER=postgres
                    export POSTGRES_PASSWORD=build-only-placeholder
                    export WEB_PORT=18080
                    export COMPOSE_PROJECT_NAME="tase-ci-${BUILD_NUMBER}"

                    docker compose -f ansible/compose.yaml build web

                    echo "Build completed successfully."
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running application integration tests...'

                sh '''
                    set -eu

                    export POSTGRES_DB=tase_ci
                    export POSTGRES_USER=postgres
                    export POSTGRES_PASSWORD="$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')"
                    export WEB_PORT=18080
                    export COMPOSE_PROJECT_NAME="tase-ci-${BUILD_NUMBER}"

                    cleanup() {
                        status=$?
                        docker compose -f ansible/compose.yaml down -v --remove-orphans || true
                        exit "$status"
                    }

                    trap cleanup EXIT

                    # Start PostgreSQL and the previously built Flask image
                    docker compose -f ansible/compose.yaml up -d --no-build --wait db web

                    # Get the running Flask container ID
                    WEB_CONTAINER=$(docker compose -f ansible/compose.yaml ps -q web)

                    test -n "$WEB_CONTAINER"

                    # Create a directory for the tests inside Flask
                    docker compose -f ansible/compose.yaml exec -T web mkdir -p /tmp/ci-tests
                    
                    # Copy the tests from Jenkins workspace into Flask
                    docker cp tests/. "$WEB_CONTAINER:/tmp/ci-tests/"

                    # Install test dependencies and execute pytest inside the web container.
                    docker compose -f ansible/compose.yaml exec -T web sh -c "
                        pip install --no-cache-dir -r /tmp/ci-tests/requirements.txt &&
                        PYTHONPATH=/app python -m pytest -v /tmp/ci-tests
                    "
                '''
            }
        }

        stage('Package') {
            steps {
                echo 'Packaging application artifact...'

                sh '''
                    set -eu

                    rm -f artifact.zip
                    zip -r artifact.zip app/

                    test -s artifact.zip

                    echo "Artifact packaged successfully."
                '''

                archiveArtifacts artifacts: 'artifact.zip', fingerprint: true
            }
        }

        stage('Upload to GitHub Release') {
            steps {
                echo 'Uploading artifact to GitHub...'

                withCredentials([
                    string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')
                ]) {
                    sh '''
                        set -eu

                        REPOSITORY="odemeytam-ui/tase-devops-exam"
                        RELEASE_TAG="jenkins-${BUILD_NUMBER}"
                        export RELEASE_TAG

                        # Create the release request
                        RELEASE_JSON=$(python3 -c '
import json, os
print(json.dumps({
    "tag_name": os.environ["RELEASE_TAG"],
    "name": "Jenkins Build " + os.environ["BUILD_NUMBER"],
    "body": "Automated release created by Jenkins.",
    "target_commitish": os.environ.get("GIT_COMMIT") or "main"
}))
')

                        # Create a GitHub Release
                        RESPONSE=$(curl -fsS -X POST \
                            "https://api.github.com/repos/${REPOSITORY}/releases" \
                            -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            -H "X-GitHub-Api-Version: 2022-11-28" \
                            -H "Content-Type: application/json" \
                            -d "$RELEASE_JSON")

                        # Extract the release ID from GitHub's response
                        RELEASE_ID=$(printf '%s' "$RESPONSE" | python3 -c '
import json, sys
print(json.load(sys.stdin)["id"])
')

                        # Upload artifact.zip to the release
                        curl -fsS -X POST \
                            "https://uploads.github.com/repos/${REPOSITORY}/releases/${RELEASE_ID}/assets?name=artifact.zip" \
                            -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/zip" \
                            --data-binary @artifact.zip

                        echo "Artifact uploaded successfully!"
                        echo "Release tag: ${RELEASE_TAG}"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Please check the build logs.'
        }
    }
}